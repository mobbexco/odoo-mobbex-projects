<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="payment_acquirer_view_form_inherit_payment_mobbex" model="ir.ui.view">
            <field name="name">Mobbex Payment Provider Form</field>
            <field name="model">payment.provider</field>
            <field name="inherit_id" ref="payment.payment_provider_form" />
            <field name="arch" type="xml">
                <!-- Credentials -->
                <group name="provider_credentials" position="inside">
                    <group invisible="code != 'mobbex'" name="mobbex_credentials">
                        <field name="mobbex_api_key" string="Api Key" password="True"/>
                        <field name="mobbex_access_token" string="Access Token" password="True"/>
                    </group>
                </group>
                
                <!-- Configuration-->
                <xpath expr="//page[@name='configuration']" position="inside">
                    <group string="Mobbex" invisible="code != 'mobbex'" name="mobbex_settings">
                        <group>
                            <field name="mobbex_enable_debug" string="Modo Debug"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>